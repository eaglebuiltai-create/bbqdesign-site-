# ---------------------------------------------------------------------------
# Database — Neon Postgres.
#
# Neon gives you two connection strings for the same database. You need both:
#   DATABASE_URL  the POOLED one (host contains "-pooler"). Used by the app.
#   DIRECT_URL    the DIRECT one (no "-pooler"). Used by migrations only,
#                 which cannot run through a connection pooler.
#
# Vercel is serverless: every request can be a fresh function instance, so
# without the pooler Neon runs out of connections under any real traffic.
#
# Use a separate Neon BRANCH for local development so testing never writes
# into the live lead database.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth. Sessions are JWT, so no session table is needed.
# NEXTAUTH_URL must match the deployed origin or login redirects break.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Ingest key. Must match CRM_LEADS_API_KEY in the Cloudflare Worker exactly.
LEADS_API_KEY="replace-with-a-strong-random-key"

# Seed owner account (used by prisma/seed.ts)
SEED_USER_EMAIL="info@eaglebuilt.ai"
SEED_USER_PASSWORD="change-me-on-deploy"
SEED_USER_NAME="John Simpson"
